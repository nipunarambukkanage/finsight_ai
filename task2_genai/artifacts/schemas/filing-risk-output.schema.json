    "risks": {"type": "array", "items": {"type": "object", "required": ["category", "explanation", "abstain"], "properties": {"category": {"enum": ["liquidity", "leverage", "customer_concentration", "competition", "regulation", "cybersecurity", "supply_chain", "insufficient_evidence"]}, "explanation": {"type": "string", "minLength": 1}, "supporting_quote": {"type": ["string", "null"]}, "document_id": {"type": ["string", "null"]}, "abstain": {"type": "boolean"}}}},
