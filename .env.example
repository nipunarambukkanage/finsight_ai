
APP_NAME=FinSight AI
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-super-secret-key-32chars
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

HOST=0.0.0.0
PORT=8000

DATABASE_URL=sqlite+aiosqlite:///./finsight.db

REDIS_URL=redis://localhost:6379/0
FINSIGHT_MEMORY_DB=./data/memory.sqlite3

DEFAULT_LLM_PROVIDER=DEMO
DEMO_MODE=True

OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_TOKEN=
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

HF_SENTIMENT_MODEL=ProsusAI/finbert
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_DEVICE=cpu
FINSIGHT_ENABLE_LOCAL_EMBEDDINGS=False
FINSIGHT_ALLOW_SYNTHETIC_EMBEDDINGS=True
FINSIGHT_REQUIRE_CONTAINER_SANDBOX=False

UPLOAD_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vector_store
MAX_UPLOAD_SIZE_BYTES=26214400
