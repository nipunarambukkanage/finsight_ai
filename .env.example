# ==============================================================================
# FinSight AI - Environment Configuration Template
# All external services are OPTIONAL. The platform automatically operates in
# DEMO MODE with realistic deterministic market & AI intelligence when keys are absent.
# ==============================================================================

# Application Configuration
APP_NAME=FinSight AI
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-super-secret-key-32chars
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (Defaults to SQLite in local dev if PostgreSQL is not running)
DATABASE_URL=sqlite+aiosqlite:///./finsight.db
# For PostgreSQL + pgvector:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finsight_ai

# Cache Configuration (Falls back to in-memory cache if Redis is unavailable)
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
# Supported providers: DEMO, OPENAI, ANTHROPIC, HUGGINGFACE, BEDROCK
DEFAULT_LLM_PROVIDER=DEMO
DEMO_MODE=True

# Optional Third-Party LLM API Keys (Leave blank to use DemoProvider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_TOKEN=

# AWS Credentials (Optional, for AWS deployment & Bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Hugging Face Local Model Settings
HF_SENTIMENT_MODEL=ProsusAI/finbert
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_DEVICE=cpu

# RAG & Document Storage
UPLOAD_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vector_store
MAX_UPLOAD_SIZE_BYTES=26214400  # 25 MB
